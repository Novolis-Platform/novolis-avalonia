<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Audio</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Avalonia multi-track audio editor chrome (Music Maker / Audacity–style lightweight).</Description>
    <RootNamespace>Novolis.Avalonia.Audio</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="NAudio" />
    <LibraryReference Include="Novolis.Audio.Core" />
    <LibraryReference Include="Novolis.Audio.Catalog" />
    <LibraryReference Include="Novolis.Audio.Edit" />
    <LibraryReference Include="Novolis.Audio.Midi" />
    <LibraryReference Include="Novolis.Audio.MusicTheory" />
  </ItemGroup>
</Project>
