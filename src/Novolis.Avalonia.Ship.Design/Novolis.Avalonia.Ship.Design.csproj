<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Ship.Design</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Object-first Ship Designer Avalonia UI: PLAN/MODEL/PRESENT, ShipDesignSession, create panel, grips, object tools.</Description>
    <RootNamespace>Novolis.Avalonia.Ship.Design</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Novolis.Cad.Primitives" />
    <PackageReference Include="Novolis.Ship.Primitives" />
    <PackageReference Include="Novolis.Ship.Topology" />
    <PackageReference Include="Novolis.Ship.Validation" />
    <PackageReference Include="Novolis.Ship.Design" />
    <PackageReference Include="Novolis.Math.Measure" />
    <PackageReference Include="Novolis.3D.Scene" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Avalonia.Cad\Novolis.Avalonia.Cad.csproj" />
    <ProjectReference Include="..\Novolis.Avalonia.Cad.Ship\Novolis.Avalonia.Cad.Ship.csproj" />
    <ProjectReference Include="..\Novolis.Avalonia.Ship\Novolis.Avalonia.Ship.csproj" />
  </ItemGroup>
</Project>
