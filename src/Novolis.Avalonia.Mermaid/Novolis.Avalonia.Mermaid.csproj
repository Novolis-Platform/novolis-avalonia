<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Mermaid</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Avalonia.Mermaid</RootNamespace>
    <Description>Avalonia Mermaid diagram control: render Mermaid source (or Novolis.Markup.Mermaid builders) to SVG via Novolis.Markup.Mermaid.Rendering.</Description>
    <PackageTags>avalonia;mermaid;diagram;svg;control;novolis</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
    <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <!-- Mermaider: runtime for Mermaid.Rendering under ProjectRef (transitive when consuming NuGet). -->
    <PackageReference Include="Mermaider" />
    <PackageReference Include="Novolis.Markup.Mermaid" />
    <PackageReference Include="Novolis.Markup.Mermaid.Rendering" />
  </ItemGroup>
</Project>
