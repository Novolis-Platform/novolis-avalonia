<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Reach</PackageId>
    <RootNamespace>Novolis.Avalonia.Reach</RootNamespace>
    <IsPackable>true</IsPackable>
    <Description>Avalonia client chrome for Novolis Reach.</Description>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <LibraryReference Include="Novolis.Reach.Client" />
    <LibraryReference Include="Novolis.Reach.Protocol" />
    <LibraryReference Include="Novolis.Video.Abstractions" />
  </ItemGroup>
</Project>
