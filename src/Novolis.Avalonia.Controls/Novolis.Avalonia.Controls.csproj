<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Controls</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Reusable Avalonia interaction atoms: choice/picker dialogs, marked lists, job queue panels, sortable data grid, hex dump, detail tree (code-only, no XAML).</Description>
    <RootNamespace>Novolis.Avalonia.Controls</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>
</Project>
