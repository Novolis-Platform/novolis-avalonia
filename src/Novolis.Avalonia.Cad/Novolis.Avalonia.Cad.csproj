<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Cad</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Shared Avalonia CAD editor/preview surface (.cadjson), Raylib model view, exports, and localhost HTTP/TCP session for LLM control.</Description>
    <RootNamespace>Novolis.Avalonia.Cad</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <LibraryReference Include="Novolis.Cad.Primitives" />
    <LibraryReference Include="Novolis.Cad.SceneBridge" />
    <LibraryReference Include="Novolis.Cad.Evaluation" />
    <LibraryReference Include="Novolis.Commands.Expressions" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.ThreeD.Scene" />
    <LibraryReference Include="Novolis.Raylib.Abstractions" />
    <LibraryReference Include="Novolis.Raylib.Bindings" />
    <LibraryReference Include="Novolis.Raylib.Runtime" />
    <LibraryReference Include="Novolis.Simulation.View" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Avalonia.Raylib\Novolis.Avalonia.Raylib.csproj" />
    <ProjectReference Include="..\Novolis.Avalonia.Studio\Novolis.Avalonia.Studio.csproj" />
  </ItemGroup>
</Project>
