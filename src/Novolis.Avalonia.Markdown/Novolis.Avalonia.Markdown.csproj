<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Markdown</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Avalonia Markdown editor, live preview, and split-pane controls with line numbers and Ctrl+scroll zoom.</Description>
    <RootNamespace>Novolis.Avalonia.Markdown</RootNamespace>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Avalonia.HtmlRenderer" />
    <PackageReference Include="Novolis.Markup.Markdown" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Novolis.Avalonia.Mermaid\Novolis.Avalonia.Mermaid.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Highlighting\*.xshd" />
  </ItemGroup>
</Project>
