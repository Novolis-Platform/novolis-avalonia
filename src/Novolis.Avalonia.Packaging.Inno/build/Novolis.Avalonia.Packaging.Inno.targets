<Project>
  <PropertyGroup>
    <NovolisInnoAppName Condition="'$(NovolisInnoAppName)' == ''">Novolis Audio Live</NovolisInnoAppName>
    <NovolisInnoAppVersion Condition="'$(NovolisInnoAppVersion)' == ''">$(Version)</NovolisInnoAppVersion>
    <NovolisInnoPublishDir Condition="'$(NovolisInnoPublishDir)' == ''">$(PublishDir)</NovolisInnoPublishDir>
    <NovolisInnoAppExeName Condition="'$(NovolisInnoAppExeName)' == ''">$(AssemblyName).exe</NovolisInnoAppExeName>
    <NovolisInnoOutputDir Condition="'$(NovolisInnoOutputDir)' == ''">$(IntermediateOutputPath)installer</NovolisInnoOutputDir>
    <NovolisInnoAppId Condition="'$(NovolisInnoAppId)' == ''">Novolis.Audio.Live.Studio</NovolisInnoAppId>
    <NovolisInnoDefaultGroupName Condition="'$(NovolisInnoDefaultGroupName)' == ''">Novolis Audio Live</NovolisInnoDefaultGroupName>
    <NovolisInnoOutputBaseFilename Condition="'$(NovolisInnoOutputBaseFilename)' == ''">NovolisAudioLiveSetup</NovolisInnoOutputBaseFilename>
    <NovolisInnoInstallDirName Condition="'$(NovolisInnoInstallDirName)' == ''">Novolis\Novolis Audio Live</NovolisInnoInstallDirName>
    <NovolisInnoScriptPath Condition="'$(NovolisInnoScriptPath)' == ''">$(NovolisInnoOutputDir)\novolis-audio-live.iss</NovolisInnoScriptPath>
  </PropertyGroup>

  <Target Name="NovolisGenerateInnoScript">
    <ItemGroup>
      <_NovolisInnoScriptLines Include="; Generated by Novolis.Avalonia.Packaging.Inno" />
      <_NovolisInnoScriptLines Include="[Setup]" />
      <_NovolisInnoScriptLines Include="AppId=$(NovolisInnoAppId)" />
      <_NovolisInnoScriptLines Include="AppName=$(NovolisInnoAppName)" />
      <_NovolisInnoScriptLines Include="AppVersion=$(NovolisInnoAppVersion)" />
      <_NovolisInnoScriptLines Include="DefaultDirName={localappdata}\Programs\$(NovolisInnoInstallDirName)" />
      <_NovolisInnoScriptLines Include="DefaultGroupName=$(NovolisInnoDefaultGroupName)" />
      <_NovolisInnoScriptLines Include="OutputBaseFilename=$(NovolisInnoOutputBaseFilename)" />
      <_NovolisInnoScriptLines Include="OutputDir=$(NovolisInnoOutputDir)" />
      <_NovolisInnoScriptLines Include="PrivilegesRequired=lowest" />
      <_NovolisInnoScriptLines Include="DisableProgramGroupPage=yes" />
      <_NovolisInnoScriptLines Include="WizardStyle=modern" />
      <_NovolisInnoScriptLines Include="ArchitecturesAllowed=x64compatible" />
      <_NovolisInnoScriptLines Include="ArchitecturesInstallIn64BitMode=x64" />
      <_NovolisInnoScriptLines Include="Compression=lzma2" />
      <_NovolisInnoScriptLines Include="SolidCompression=yes" />
      <_NovolisInnoScriptLines Include="UninstallDisplayIcon={app}\$(NovolisInnoAppExeName)" />
      <_NovolisInnoScriptLines Include="[Tasks]" />
      <_NovolisInnoScriptLines Include="Name: &quot;desktopicon&quot;; Description: &quot;Create a &amp;desktop icon&quot;; GroupDescription: &quot;Additional icons:&quot;; Flags: unchecked" />
      <_NovolisInnoScriptLines Include="[Files]" />
      <_NovolisInnoScriptLines Include="Source: &quot;$(NovolisInnoPublishDir)\*&quot;; DestDir: &quot;{app}&quot;; Flags: ignoreversion recursesubdirs createallsubdirs" />
      <_NovolisInnoScriptLines Include="[Icons]" />
      <_NovolisInnoScriptLines Include="Name: &quot;{autoprograms}\$(NovolisInnoDefaultGroupName)&quot;; Filename: &quot;{app}\$(NovolisInnoAppExeName)&quot;" />
      <_NovolisInnoScriptLines Include="Name: &quot;{autodesktop}\$(NovolisInnoDefaultGroupName)&quot;; Filename: &quot;{app}\$(NovolisInnoAppExeName)&quot;; Tasks: desktopicon" />
      <_NovolisInnoScriptLines Include="[Run]" />
      <_NovolisInnoScriptLines Include="Filename: &quot;{app}\$(NovolisInnoAppExeName)&quot;; Description: &quot;Launch $(NovolisInnoAppName)&quot;; Flags: nowait postinstall skipifsilent" />
    </ItemGroup>

    <WriteLinesToFile
      File="$(NovolisInnoScriptPath)"
      Lines="@(_NovolisInnoScriptLines)"
      Overwrite="true"
      Encoding="UTF-8" />

    <Message Importance="high" Text="Novolis Inno: wrote $(NovolisInnoScriptPath)" />
  </Target>
</Project>
