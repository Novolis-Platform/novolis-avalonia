<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Video</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Avalonia video surface, storyboard strip, and Movie Maker preview session.</Description>
    <RootNamespace>Novolis.Avalonia.Video</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Novolis.Video.Rtc.Abstractions" />
    <PackageReference Include="Novolis.Video.Edit" />
  </ItemGroup>
</Project>
