<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Gaming</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Avalonia.Gaming</RootNamespace>
    <Description>Avalonia game shell: Silk/TwoD viewport host with HUD and modal menu overlays, HardPause defaults for interactive UIs.</Description>
    <PackageTags>novolis;avalonia;gaming;hud;menu;silk;twod</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <ProjectReference Include="..\Novolis.Avalonia.Rendering\Novolis.Avalonia.Rendering.csproj" />
  </ItemGroup>
</Project>
