<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.AssetStudio</PackageId>
    <RootNamespace>Novolis.Avalonia.AssetStudio</RootNamespace>
    <Description>Reusable Avalonia editor surfaces for Asset Studio graph, stack, source, diagnostics, and preview workflows.</Description>
    <PackageTags>assetstudio;visual;avalonia;editor;graph;preview</PackageTags>
    <IsPackable>true</IsPackable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <LibraryReference Include="Novolis.AssetStudio.Authoring" />
    <LibraryReference Include="Novolis.Visual.Definitions" />
    <LibraryReference Include="Novolis.Visual.Materials" />
    <LibraryReference Include="Novolis.Visual.Assets" />
    <LibraryReference Include="Novolis.Visual.Presets" />
    <LibraryReference Include="Novolis.Visual.Compile" />
    <LibraryReference Include="Novolis.Visual.Evaluation" />
    <LibraryReference Include="Novolis.Visual.Baking" />
    <LibraryReference Include="Novolis.Visual.Adapters.Rendering" />
    <LibraryReference Include="Novolis.Rendering.Backends.Cpu" />
    <LibraryReference Include="Novolis.Rendering.Compile" />
    <LibraryReference Include="Novolis.Rendering.Presentation.Abstractions" />
    <LibraryReference Include="Novolis.Rendering.Runtime" />
    <LibraryReference Include="Novolis.Rendering.Scene" />
    <LibraryReference Include="Novolis.Rendering.Materials" />
    <LibraryReference Include="Novolis.Modeling.Scene" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.Avalonia.GraphicalProfile" />
    <LibraryReference Include="Novolis.Avalonia.Layout" />
    <LibraryReference Include="Novolis.Avalonia.Studio" />
  </ItemGroup>
</Project>
