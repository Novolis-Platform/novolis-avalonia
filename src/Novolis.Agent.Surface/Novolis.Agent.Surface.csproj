<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Agent.Surface</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Attributed agent surface definitions that auto-build action catalogs, JSON Schema, OpenAPI fragments, MCP descriptors, and localhost HTTP/TCP JSONL hosts.</Description>
    <RootNamespace>Novolis.Agent.Surface</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
