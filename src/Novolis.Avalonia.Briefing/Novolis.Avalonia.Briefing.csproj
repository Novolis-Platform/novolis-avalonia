<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Briefing</PackageId>
    <IsPackable>true</IsPackable>
    <RootNamespace>Novolis.Avalonia.Briefing</RootNamespace>
    <Description>Avalonia briefing primitives: radio feed, scorecard, dual metric strip, and metric tables (code-only, no XAML).</Description>
    <PackageTags>novolis;avalonia;briefing;scorecard;feed</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Controls.DataGrid" />
  </ItemGroup>
</Project>
