<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <PackageId>Novolis.Avalonia.Modeling</PackageId>
    <IsPackable>true</IsPackable>
    <Description>Avalonia Modeling editor surface: scene hierarchy, OpenGL wireframe viewport, mesh tools, lights, cameras, and agent session.</Description>
    <RootNamespace>Novolis.Avalonia.Modeling</RootNamespace>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <LibraryReference Include="Novolis.Math.Geometry" />
    <LibraryReference Include="Novolis.Agent.Core" />
    <LibraryReference Include="Novolis.Agent.Surface" />
    <LibraryReference Include="Novolis.Raylib.Abstractions" />
    <LibraryReference Include="Novolis.Raylib.Bindings" />
    <LibraryReference Include="Novolis.Raylib.Runtime" />
    <LibraryReference Include="Novolis.Simulation.View" />
    <LibraryReference Include="Novolis.Silk.Runtime" />
    <LibraryReference Include="Novolis.Rendering.Backends.Vulkan" />
    <LibraryReference Include="Novolis.Rendering.Scene" />
    <LibraryReference Include="Novolis.Rendering.Materials" />
  </ItemGroup>
  <ItemGroup>
    <LibraryReference Include="Novolis.Modeling.Scene" />
    <LibraryReference Include="Novolis.Modeling.Import.Assimp" />
    <ProjectReference Include="..\Novolis.Avalonia.Rendering\Novolis.Avalonia.Rendering.csproj" />
    <ProjectReference Include="..\Novolis.Avalonia.Raylib\Novolis.Avalonia.Raylib.csproj" />
  </ItemGroup>
</Project>
