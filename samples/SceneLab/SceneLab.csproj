<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>SceneLab</RootNamespace>
    <IsPackable>false</IsPackable>
    <Description>Same-repo CAD 3D editor sample host for Novolis.Avalonia.3D (ProjectReference); Modeling.Scene and Agent.Surface via PackageReference.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Novolis.Agent.Surface" />
    <PackageReference Include="Novolis.Modeling.Scene" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Novolis.Avalonia.3D\Novolis.Avalonia.3D.csproj" />
  </ItemGroup>
</Project>
